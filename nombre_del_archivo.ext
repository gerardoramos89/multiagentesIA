```javascript
// ARCHIVO: nombre_del_archivo.ext

// Importaciones necesarias
import { Router } from 'express';
import { Container } from 'inversify';
import { CQRSCommandBus, CQRSQueryBus } from './core/cqrs';
import { AgentModule } from './agents';
import { CommunicationModule } from './communication';
import { config } from './config';
import { logger } from './utils/logger';

// Creación del contenedor Inversify
const container = new Container();

// Configuración de los módulos
container.bind(AgentModule).toSelf();
container.bind(CommunicationModule).toSelf();

// Configuración de los buses CQRS
container.bind(CQRSCommandBus).toSelf();
container.bind(CQRSQueryBus).toSelf();

// Configuración de la aplicación Express
const app = Router();

// Middleware para manejar errores globales
app.use((err, req, res, next) => {
  logger.error(`Error: ${err.message}`);
  res.status(err.status || 500).send(err.message);
});

// Rutas de la aplicación
app.use('/api', AgentModule);
app.use('/api', CommunicationModule);

// Inicialización de la aplicación
const server = app.listen(config.port, () => {
  logger.info(`Server is running on port ${config.port}`);
});

export { app, server, container };
```

```typescript
// ARCHIVO: nombre_del_archivo.ext

// Importaciones necesarias
import { injectable, inject } from 'inversify';
import { CommandHandler, QueryHandler } from '../core/cqrs';
import { AgentRepository } from './agent.repository';
import { TrainAgentCommand, TrainAgentHandler } from './commands/train-agent.command';
import { GetAgentStatusQuery, GetAgentStatusHandler } from './queries/get-agent-status.query';

// Definición del módulo Agent
@injectable()
export class AgentModule {
  private readonly agentRepository: AgentRepository;

  constructor(
    @inject(AgentRepository) agentRepository: AgentRepository
  ) {
    this.agentRepository = agentRepository;
  }

  // Configuración de las rutas
  public configureRoutes(router: Router): void {
    router.post('/agents/train', this.trainAgent.bind(this));
    router.get('/agents/:id/status', this.getAgentStatus.bind(this));
  }

  // Manejador para el comando de entrenamiento del agente
  @CommandHandler(TrainAgentCommand)
  private async trainAgent(req: Request, res: Response): Promise<void> {
    const command = new TrainAgentCommand(req.body);
    await container.get(TrainAgentHandler).handle(command);
    res.status(200).send('Agent trained successfully');
  }

  // Manejador para la consulta del estado del agente
  @QueryHandler(GetAgentStatusQuery)
  private async getAgentStatus(req: Request, res: Response): Promise<void> {
    const query = new GetAgentStatusQuery(req.params.id);
    const status = await container.get(GetAgentStatusHandler).handle(query);
    res.status(200).json(status);
  }
}
```

