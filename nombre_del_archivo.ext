import { Entity, PrimaryGeneratedColumn, Column, CreateDateColumn } from 'typeorm';

// Definición del modelo de Agente
@Entity()
export class Agent {
  @PrimaryGeneratedColumn()
  id: number;

  @Column()
  name: string;

  @Column({ type: 'text' })
  trainingData: string;

  @CreateDateColumn()
  createdAt: Date;
}
