```javascript
// Importaciones necesarias
import express from 'express';
import axios from 'axios';
import { v4 as uuidv4 } from 'uuid';
import { validateInput } from '../utils/validators';
import { handleError } from '../utils/errorHandler';

// Creación del router
const router = express.Router();

// Definición de endpoints
router.post('/sprints', async (req, res) => {
  try {
    // Validación de la entrada
    const validationErrors = validateInput(req.body);
    if (validationErrors.length > 0) {
      return res.status(400).json({ errors: validationErrors });
    }

    // Llamada a la API de Ollama para generar un plan de sprints
    const response = await axios.post('https://api.ollama.io/generatePlan', {
      project: req.body.project,
      duration: req.body.duration,
      teamSize: req.body.teamSize
    });

    // Llamada a la API de Trello para crear un nuevo sprint
    const trelloResponse = await axios.post('https://api.trello.com/1/lists', {
      name: `Sprint ${uuidv4()}`,
      idBoard: req.body.boardId
    }, {
      params: {
        key: process.env.TRELLO_API_KEY,
        token: process.env.TRELLO_API_TOKEN
      }
    });

    // Respuesta exitosa
    res.status(201).json({
      message: 'Sprint creado exitosamente',
      data: {
        sprintId: trelloResponse.data.id,
        plan: response.data.plan
      }
    });
  } catch (error) {
    handleError(error, res);
  }
});

// Exportación del router
export default router;
```

```javascript
// Importaciones necesarias
import { Request, Response } from 'express';

// Función para manejar errores
export const handleError = (error, res) => {
  console.error(error);
  res.status(500).json({ error: 'Hubo un error al procesar la solicitud' });
};

// Función de validación de entrada
export const validateInput = (input) => {
  const errors = [];
  if (!input.project) errors.push('El proyecto es obligatorio');
  if (!input.duration) errors.push('La duración es obligatoria');
  if (!input.teamSize) errors.push('El tamaño del equipo es obligatorio');
  if (!input.boardId) errors.push('El ID del tablero es obligatorio');
  return errors;
};
```

```javascript
// Importaciones necesarias
import { Request, Response } from 'express';
import { handleError } from '../utils/errorHandler';

// Middleware para manejar errores globales
const errorMiddleware = (err, req, res, next) => {
  handleError(err, res);
};

// Exportación del middleware
export default errorMiddleware;
```

```javascript
// Importaciones necesarias
import express from 'express';
import cors from 'cors';
import morgan from 'morgan';
import dotenv from 'dotenv';
import sprintRouter from './routes/sprintRouter';
import errorMiddleware from './middleware/errorMiddleware';

// Configuración de variables de entorno
dotenv.config();

// Creación de la aplicación Express
const app = express();

// Configuración de middlewares
app.use(cors());
app.use(morgan('dev'));
app.use(express.json());

// Configuración de routers
app.use('/api/v1', sprintRouter);

// Configuración del middleware de errores
app.use(errorMiddleware);

// Inicio del servidor
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
  console.log(`Servidor corriendo en el puerto ${PORT}`);
});
```

