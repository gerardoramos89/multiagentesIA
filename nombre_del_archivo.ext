```javascript
// ARCHIVO: nombre_del_archivo.ext

import { NextResponse } from 'next/server';
import { signIn, signOut, getSession } from 'next-auth/react';
import { getToken } from 'next-auth/jwt';
import { getServerSession } from 'next-auth/next';
import { NextRequest } from 'next/server';

// Configuración de autenticación
const authConfig = {
  providers: [
    // Configuración de proveedores de autenticación
  ],
  callbacks: {
    async signIn({ user, account, profile, isNewUser }) {
      // Lógica de autenticación
      return true;
    },
    async signOut(params) {
      // Lógica de cierre de sesión
      return true;
    },
    async session({ session, user, token }) {
      // Personalizar la sesión
      session.user = { ...session.user, id: token.sub };
      return session;
    },
    async jwt({ token, user, account, profile, isNewUser }) {
      // Personalizar el token JWT
      if (user) {
        token.sub = user.id;
      }
      return token;
    },
  },
  pages: {
    signIn: '/auth/signin',
    signOut: '/auth/signout',
    error: '/auth/error', // Error page
  },
};

// Función para obtener la sesión del usuario
export async function getServerAuthSession(req) {
  return await getServerSession(authConfig, req);
}

// Middleware de autenticación
export async function middleware(req) {
  const session = await getServerAuthSession(req);
  if (!session) {
    return NextResponse.redirect(new URL('/auth/signin', req.url));
  }
  return NextResponse.next();
}

// Exportar funciones de autenticación
export { signIn, signOut, getSession, getToken };
```